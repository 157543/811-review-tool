{
  "name": "scut-811-review-tool",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/check-private-leaks.ts dist",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:production-smoke": "playwright test --config playwright.production.config.ts",
    "validate:schemas": "node scripts/validate-schemas.ts",
    "validate:blueprint": "node scripts/validate-blueprint.ts",
    "validate:bank": "node scripts/validate-questions.ts --mode development",
    "validate:draft-complete": "node scripts/validate-questions.ts --mode draft-complete",
    "validate:review-progress": "node scripts/validate-questions.ts --mode review-progress",
    "validate:release": "node scripts/validate-questions.ts --mode release",
    "validate:sources": "node scripts/validate-source-citations.ts",
    "report:quota": "node scripts/report-question-quota.ts",
    "check:duplicates": "node scripts/near-duplicates.ts",
    "review:phase1": "node scripts/generate-phase1-review.ts",
    "review:chapter1-v2": "node scripts/generate-chapter1-review-v2.ts",
    "apply:chapter1-review": "node scripts/apply-chapter1-review.ts",
    "apply:chapter2-review": "node scripts/apply-chapter2-review.ts",
    "apply:chapter3-review": "node scripts/apply-chapter3-review.ts",
    "apply:final-release-review": "node scripts/apply-final-release-review.ts",
    "bundle:reviewed-beta": "node scripts/bundle-reviewed-beta.ts",
    "check:phase1-content": "node scripts/validate-schemas.ts && node scripts/validate-blueprint.ts && node scripts/validate-questions.ts --mode release && node scripts/check-katex.ts && node scripts/validate-source-citations.ts && node scripts/near-duplicates.ts && node scripts/generate-phase1-review.ts",
    "generate:phase1": "node scripts/generate-phase1-bank.ts",
    "review:samples": "node scripts/generate-sample-review.ts",
    "import:questions": "node scripts/import-questions.ts",
    "bundle:bank": "node scripts/bundle-bank.ts && node scripts/validate-questions.ts --mode release",
    "check:katex": "node scripts/check-katex.ts",
    "check:private": "node scripts/check-private-leaks.ts dist",
    "check": "node scripts/validate-schemas.ts && node scripts/validate-blueprint.ts && node scripts/validate-questions.ts --mode development && node scripts/check-katex.ts && vitest run && tsc -b && vite build && node scripts/check-private-leaks.ts dist"
  },
  "dependencies": {
    "ajv": "8.17.1",
    "ajv-formats": "3.0.1",
    "csv-parse": "6.1.0",
    "dexie": "4.2.0",
    "katex": "0.16.22",
    "react": "19.1.1",
    "react-dom": "19.1.1"
  },
  "devDependencies": {
    "@playwright/test": "1.55.0",
    "@types/katex": "0.16.7",
    "@types/node": "24.3.0",
    "@types/react": "19.1.12",
    "@types/react-dom": "19.1.9",
    "@vitejs/plugin-react": "5.0.2",
    "fake-indexeddb": "6.2.2",
    "tsx": "4.20.5",
    "typescript": "5.9.2",
    "vite": "7.1.5",
    "vitest": "3.2.4"
  }
}
