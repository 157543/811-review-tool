        "id": "C",
        "content": "\\(\\displaystyle y[n]=\\sum_{k=-\\infty}^{\\infty}x[n-k]h[n-k]\\)",
        "error_tag": null
      },
      {
        "id": "D",
        "content": "\\(\\displaystyle y[n]=\\sum_{k=-\\infty}^{\\infty}x[k]h[n-k]\\)",
